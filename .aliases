
## ALIASES FOR FUNKY STUFF

DNS_SERVER_ADDRESS="10.39.6.253"
alias 3906hosts='for a in {254..1}; do ans="`dig -x 10.39.6.$a @$DNS_SERVER_ADDRESS +short +norecurse`"; if [ $ans ]; then echo -e "10.39.6.$a\t$ans";else echo -e "10.39.6.$a\t__"; unset ans; unset a; fi; done'

# What is my public IP?
alias MyIP="dig +short myip.opendns.com @resolver1.opendns.com"
alias myip="curl http://ipecho.net/plain; echo"

# sometimes you just want to hear the time
saytime () {
  h=$(date +%l)
  m=$(date +%M)
  say "its $h $m o-clock"
  unset h
  unset m
}




## ALIASES FOR COMMANDS
alias tree="ls -R | grep ":$" | sed -e 's/:$//' -e 's/[^-][^\/]*\//--/g' -e 's/^/   /' -e 's/-/|/'"
alias ll="ls -alh"

#Don't need this if the ~/.config/duo-sso/config.json includes device and factor default options
#alias duo-sso="duo-sso -device phone1 -factor push"

alias json-lint="python3 -mjson.tool "
# usage `json-lint <filename>`
# output (with errors): Expecting ',' delimiter: line 8 column 3 (char 248)
# output (all is good): <dumps the entire json> | use `> /dev/null` to squelch

## VARIOUS SSH SHORTCUTS
###### I should really probably be making better use of .ssh/config for these, maybe.

###  Azure stuff
# usage: azure <ip/host>
alias azure="ssh -i ~/.ssh/jamegill-azure-2020.pem -l jamegill "

### AWS Stuff
# usage: dev
alias dev='ssh -i "~/.ssh/jamegill.LightsailDefaultKey-us-east-1.pem" -l bitnami ghost-1.thirtynineohsix.com'
alias ec2='ssh -i "~/.ssh/jamegill_aws_vpc001.pem" -l ec2-user '

#### AWS Stuff for KB
alias kb-aws='ssh -i "~/.ssh/KBellaevents-AWS-DefaultVPC-KeyPair202111.pem" -l ec2-user '
alias kb-ls='ssh -i "~/.ssh/KBellaevents-AWS-DefaultVPC-KeyPair202111.pem" -l bitnami'
alias kb-aws-wp='ssh -i ".ssh/KBellaevents-AWS-DefaultVPC-KeyPair202111.pem" bitnami@ec2-52-91-59-168.compute-1.amazonaws.com'
alias frenchdoor="kb-ls frenchdoorevents.com"
alias kbellevents="kb-ls kbellaevents.com"
alias kbv3="kb-ls v3.kbellaevents.com"


